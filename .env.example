# ============================================================
#  把这份文件复制成 .env，然后把 key 填进去
#  （在 Windows 资源管理器里复制一份、改名即可）
# ============================================================

# Agent 用的模型：既负责生成回答，也负责"决定调哪个工具"
# 用 DeepSeek，便宜且支持 function calling
# 申请地址：https://platform.deepseek.com/api_keys
LLM_API_KEY=sk-你的密钥
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ------------------------------------------------------------
# 可选：本地知识库项目（rag-pdf）的路径
# 不填就用默认路径；如果你的 rag-pdf 放在别处，把路径写在这里。
# 找不到也不影响运行——知识库工具会提示不可用，其它三个工具照常用。
# ------------------------------------------------------------
RAG_PROJECT_DIR=C:/Users/Sun/Desktop/workbuddy/rag-pdf
